# --- Base de données (docker-compose : port 5434) ---
DATABASE_URL=postgres://greenu:greenu@localhost:5434/greenu
# Base utilisée par `pnpm test` et `pnpm test:e2e`
DATABASE_URL_TEST=postgres://greenu:greenu@localhost:5434/greenu_test

# --- Application ---
# URL publique, utilisée dans les liens des e-mails
APP_URL=http://localhost:3000
# Secret de signature des sessions et jetons (32 octets min.) : openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-change-me-change-me-change-me

# --- E-mails (Mailpit en dev : SMTP 1026, UI http://localhost:8026) ---
SMTP_HOST=localhost
SMTP_PORT=1026
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM="GreenU <no-reply@greenu.local>"

# --- Stockage des fichiers ---
# local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./var/uploads

# --- Tests uniquement ---
# API HTTP de Mailpit, lue par les tests e2e
MAILPIT_API_URL=http://localhost:8026
# Horloge figée côté serveur (ISO 8601). Laisser vide hors tests.
APP_NOW=
# Les variables suivantes sont fixées par playwright.config.ts et vitest.config.ts ; inutile de les définir à la main.
# Date de référence du seed (ISO 8601) ; par défaut, la date du jour.
# SEED_REFERENCE_DATE=
# Dossier de build de Next (les e2e utilisent .next-e2e).
# NEXT_DIST_DIR=.next
# Fuseau de Node pour Vitest (par défaut America/New_York).
# TEST_TZ=

# --- Modules optionnels ---
FEATURE_WEATHER=false
